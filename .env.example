# Authentication. Production requires at least one configured provider.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
ATLAS_ALLOWED_EMAIL_DOMAINS=
ATLAS_ADMIN_EMAILS=
ATLAS_EDITOR_EMAILS=
ATLAS_DEMO_AUTH=true

# Data. Atlas uses an in-memory development repository when DATABASE_URL is absent.
DATABASE_URL=

# OpenAI. When unset, Atlas uses a deterministic local evidence search demo.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_IMAGE_MODEL=
OPENAI_VECTOR_STORE_ID=

# Optional S3-compatible document storage. Local development falls back to /tmp.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Protect the administrator ingestion endpoint when called by CI.
ATLAS_INGESTION_SECRET=
