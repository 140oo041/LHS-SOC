# Authentication.
#
# A deployment refuses to serve authenticated requests until AUTH_SECRET, one
# identity provider, and ATLAS_ALLOWED_EMAIL_DOMAINS are all set; the reasons
# are printed to the server log. Only `next dev` is exempt.

# Public read-only access: anyone may read Atlas without signing in.
# Opt-in by exact value "true"; anything else keeps Atlas private. A visitor
# becomes a `viewer`, and every mutating route requires admin or editor, so
# public access can never mean public writes. With this set, none of the
# sign-in variables below are required.
ATLAS_PUBLIC_ACCESS=

# Required once an identity provider is configured below.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# At least one provider is required.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# Who may sign in. Comma-separated; an empty list admits nobody.
# Anyone admitted only by these lists signs in as a viewer.
ATLAS_ALLOWED_EMAIL_DOMAINS=
ATLAS_ALLOWED_EMAILS=

# Bootstrap administrators. Always admin, and the only roles the admin
# console cannot change, so the workspace can never lose its last admin.
# Everyone else's role is granted in Admin > People and stored in the
# database; changes apply from the person's next request.
ATLAS_ADMIN_EMAILS=
# Deprecated: grant editor in Admin > People instead. Still honoured for
# anyone without a role granted there.
ATLAS_EDITOR_EMAILS=

# Unauthenticated admin actor for local work against no IdP. Honoured only
# when NODE_ENV=development, and only for the exact value "true". Never set
# this on a deployment: it is reported as a configuration error.
ATLAS_DEMO_AUTH=true

# Data. Atlas uses an in-memory development repository when DATABASE_URL is absent.
#
# On Neon, DATABASE_URL is the pooled URL (its host contains "-pooler") and
# DATABASE_URL_UNPOOLED is the direct one; migrations need the direct URL
# because they hold a session-level lock. Remote connections verify the
# server certificate. sslmode=disable and sslmode=no-verify are refused.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Only for a host whose certificate is not publicly trusted.
# DATABASE_CA_CERT=

# Authorizes Vercel Cron's daily call to /api/cron/daily. Vercel sends it as
# a Bearer token. Generate with: openssl rand -base64 32
CRON_SECRET=

# AI integration is OFF and is not controlled from here.
#
# lib/features.ts holds a constant that no environment variable can override,
# so setting a key below does nothing on its own. Even with the constant on,
# Atlas sends no paid request until spend is bounded: DATABASE_URL (so the
# rate limiter and monthly budget hold across serverless instances), a
# monthly request limit and dollar budget, and token prices to estimate cost
# against. Admin > Knowledge revision lists whatever is still missing. Also
# set a hard budget on the OpenAI project itself; Atlas's is an estimate.
#
# Put the key in the host's secret store. Never in this file, never committed.
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=
# OPENAI_IMAGE_MODEL=
# OPENAI_VECTOR_STORE_ID=
# ATLAS_AI_MONTHLY_REQUEST_LIMIT=
# ATLAS_AI_MONTHLY_BUDGET_USD=
# Current prices from the provider's pricing page, in US dollars.
# ATLAS_AI_PRICE_INPUT_PER_MTOK=
# ATLAS_AI_PRICE_OUTPUT_PER_MTOK=
# ATLAS_AI_PRICE_FILE_SEARCH_PER_1K=
# ATLAS_AI_PRICE_IMAGE_EACH=

# Wiki versioning through GitHub.
#
# Without these, the wiki is the docs/ folder bundled with the deployment,
# read-only. With them, wiki branches are branches of the repository, change
# requests are pull requests, and merges appear without a redeploy.
#
# Create a GitHub App (Settings > Developer settings > GitHub Apps) with
# repository permissions Contents: read & write, Pull requests: read & write,
# Metadata: read; subscribe to the Push and Pull request events; set the
# webhook URL to https://<atlas-host>/api/github/webhook with a secret. Install
# it on this repository only. The installation ID is the number at the end of
# the installation's settings URL.
GITHUB_APP_ID=
# The App's private key: the PEM as downloaded, or base64-encoded on one line.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
# owner/repo
GITHUB_REPOSITORY=
GITHUB_DEFAULT_BRANCH=main
GITHUB_WEBHOOK_SECRET=

# S3-compatible document storage. Local development falls back to /tmp.
#
# Cloudflare R2 (free tier): S3_REGION=auto and
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com. Browsers upload
# and download directly against the bucket through short-lived signed links,
# so the bucket needs a CORS rule allowing GET and PUT from the Atlas origin
# with the Content-Type header.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set to AES256 for AWS S3. Leave empty for R2, which encrypts at rest and
# rejects the header.
S3_SSE=
# Largest file sent straight to the bucket, in bytes. Defaults to 100 MB.
ATLAS_MAX_DIRECT_UPLOAD_BYTES=

# Protect the administrator ingestion endpoint when called by CI.
ATLAS_INGESTION_SECRET=

# Largest upload Atlas carries itself, in bytes, which only happens on a
# developer's machine with no bucket. Defaults to 4 MB.
ATLAS_MAX_UPLOAD_BYTES=
